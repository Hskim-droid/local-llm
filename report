#!/usr/bin/env bash
# macOS / Linux: type `report`, drop files, press Enter
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$ROOT/reportctl.py" "$@"
fi
exec python "$ROOT/reportctl.py" "$@"
