{
  "$id": "local-llm-report-minutes",
  "title": "회의록/장표 보고서 content.json",
  "type": "object",
  "required": ["title", "header", "sections", "closing"],
  "properties": {
    "title": { "type": "string" },
    "header": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "note": { "type": ["string", "null"] },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "blocks"],
        "properties": {
          "heading": { "type": "string" },
          "blocks": { "type": "array" }
        }
      }
    },
    "closing": { "type": "string", "const": "끝." },
    "appendix": { "type": ["object", "null"] }
  }
}
